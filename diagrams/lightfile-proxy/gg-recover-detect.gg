doc {
  cellSize: 200,
  theme: { primary: "#1168bd", secondary: "#64748b", accent: "#b91c1c" },
}

region @C1:C1 "応答あり" color=primary/14

icon :viewer @A1 tabler/user            "エンドユーザー"   color=secondary
icon :cf     @B1 tabler/cloud           "CloudFront"      color=secondary
icon :proxy  @C1 tabler/transform-point "LightFile Proxy" color=primary
icon :origin @D1 tabler/server          "オリジンサーバー" color=secondary
icon :ops    @B2 tabler/user            "運用担当者"       color=secondary
icon :watch  @C2 tabler/activity        "死活監視"         color=primary

viewer --> cf "画像をリクエスト"
cf --> origin "まだ直接" color=accent
watch ..> proxy "ping.jpgが返る"
watch --> cf "優先順を元に戻す"
watch --> ops "復旧を知らせる"
